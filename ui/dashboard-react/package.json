{
  "name": "tradertrailing-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:contracts && npm run test:data && npm run test:decimal && npm run test:auth && npm run test:pwa-refresh && npm run test:startup-experience && npm run test:push && npm run test:bot-detail && npm run test:bot-create-mobile && npm run test:trade-stability && npm run test:admin-accounts && npm run test:cutover",
    "test:contracts": "node scripts/verify-build.mjs",
    "test:data": "node --experimental-strip-types scripts/dashboard-data.contract.ts",
    "test:decimal": "node --experimental-strip-types scripts/decimal.contract.ts",
    "test:auth": "node --experimental-strip-types scripts/auth.contract.ts",
    "test:pwa-refresh": "node scripts/pwa-refresh.contract.mjs",
    "test:startup-experience": "node scripts/startup-experience.contract.mjs",
    "test:push": "node scripts/push-notifications.contract.mjs",
    "test:bot-detail": "node scripts/bot-detail.contract.mjs",
    "test:bot-create-mobile": "node scripts/bot-create-mobile.contract.mjs",
    "test:trade-stability": "node scripts/trade-stability.contract.mjs",
    "test:admin-accounts": "node scripts/admin-accounts.contract.mjs",
    "test:cutover": "node scripts/verify-cutover.mjs",
    "verify": "npm run lint && npm run build && npm run test",
    "mock-server": "tsx server.mock.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
