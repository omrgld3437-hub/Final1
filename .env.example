# Binance Master Key – API key/secret ve at-rest şifreleme için ZORUNLU
# En az 32 karakter. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Veya: python scripts/devops/setup_env_master_key.py
BINANCE_MASTER_KEY=your-32-character-encryption-key-here

# Ortam: development | production
# Production'da ALLOWED_ORIGINS zorunludur ve wildcard (*) kabul edilmez.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# İsteğe bağlı: HKDF tuzu (AES-256-GCM v2). Boş bırakılırsa uygulama varsayılanı kullanılır.
# ENCRYPTION_SALT=your-deployment-unique-salt-here

# Database URL (varsayilan: ~/.trader/dca.db - proje silinse bile korunur)
# DATABASE_URL bos birakilirsa ~/.trader/dca.db kullanilir
# DATABASE_URL=sqlite:////Users/KULLANICI/.trader/dca.db

# Eski davranis — KULLANMAYIN (proje temizliginde silinebilir, disk I/O hatasi verir):
# DATABASE_URL=sqlite:///./dca.db

# PostgreSQL (production icin):
# DATABASE_URL=postgresql+psycopg://trader:change-me@postgres:5432/tradertrailing
# PG_STATEMENT_TIMEOUT_MS=15000

# Binance user stream: spot => executionReport, futures => ORDER_TRADE_UPDATE
BINANCE_USER_STREAM_ENABLED=1
# Yerel geliştirmede ISP/geo HTML engeli varsa 0 yapın (bot REST ile çalışır)
BINANCE_USER_STREAM_MARKET=spot
# HTML/geo blokta hayalet uyarı eşiği ve retry seyrekliği (varsayılan: 24 saat uyarı, 1-6 saat retry)
BINANCE_USER_STREAM_NETWORK_BLOCK_WARN_INTERVAL_SEC=86400
BINANCE_USER_STREAM_NETWORK_BLOCK_BACKOFF_BASE_SEC=3600
BINANCE_USER_STREAM_NETWORK_BLOCK_BACKOFF_MAX_SEC=21600

# Admin sifresini giris yapmadan sifirlamak icin (yayinda admin giremiyorsan): bir kez tanimla, POST /api/auth/reset-admin-password-with-secret cagir, sonra satiri sil
# ADMIN_PASSWORD_RESET_SECRET=rastgele-uzun-bir-metin

# DataHub: UI stale fiyat goster (1=evet). Botlar stale fiyatla asla trade atmaz.
# DATAHUB_SERVE_STALE_FOR_UI=1

# Auth cookie: Secure=1 forces Secure flag on auth_token cookie (HTTPS). If 0, auto-detect from request.url.scheme.
# AUTH_COOKIE_SECURE=1

# --- Auth & HTTP güvenlik (varsayilan: acik) ---
# AUTH_CSRF_ENABLED=1
# AUTH_CSRF_ORIGIN_CHECK=1
# AUTH_CSRF_DOUBLE_SUBMIT=1
# AUTH_RATE_LIMIT_ENABLED=1
# AUTH_RATE_LIMIT_LOGIN_PER_IP_5MIN=20
# AUTH_RATE_LIMIT_LOGIN_PER_USER_5MIN=10
# AUTH_ALLOW_BEARER=1
# AUTH_COOKIE_PRIMARY=0
# Kalici oturum: acik kullanildikca sure yeniden 10 yila uzatilir.
# Yalnizca acik cikis, admin iptali veya guvenlik iptali oturumu sonlandirir.
SESSION_TTL_DAYS=3650
AUTH_COOKIE_MAX_AGE_SEC=315360000
AUTH_SLIDING_TTL=1
# Production HTTPS yayininda 1 olmalidir.
# AUTH_COOKIE_SECURE=1
# SECURITY_HEADERS_ENABLED=1
# CSP_ENABLED=1
# CSP_REPORT_ONLY=1
# BREACH_SHUTDOWN=1

# Binance REST yük izleme dosyası (rest.log). Varsayılan kapalı; throttle/budget her zaman aktif.
# REST_LOG_FILE_ENABLED=0
# Açılırsa: logs/rest.log (veya REST_LOG_PATH)
# REST_LOG_PATH=logs/rest.log

# RAM probe JSONL (logs/ram_snapshots.log). Varsayılan kapalı — bellek analizi için açın.
# RAM_PROBE=0
# RAM_PROBE_ENABLED=0

# DPS karar JSON dosyaları (logs/dynamic_param_score/*.json). DB kaydı ayrı; varsayılan kapalı.
# DPS_FILE_LOG_ENABLED=0

# Log bakımı: aktif logları arşivle, 90 günden eski arşivleri sil.
# LOG_RETENTION_DAYS=90
# LOG_MAINTAIN_INTERVAL_SEC=86400
# LOG_ACTIVE_MAX_MB=25
# LOG_ROTATE_INTERVAL_DAYS=1
