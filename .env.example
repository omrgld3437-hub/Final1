# Binance Master Key – API key/secret şifreleme için ZORUNLU (yoksa API key kaydedilemez)
# En az 32 karakter olmalı. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Veya proje kökünde: python scripts/setup_env_master_key.py  (.env yoksa oluşturur)
BINANCE_MASTER_KEY=your-32-character-encryption-key-here

# Database URL (varsayilan: ~/.trader/dca.db - proje silinse bile korunur)
# DATABASE_URL bos birakilirsa ~/.trader/dca.db kullanilir
# DATABASE_URL=sqlite:////Users/KULLANICI/.trader/dca.db

# Eski davranis — KULLANMAYIN (proje temizliginde silinebilir, disk I/O hatasi verir):
# DATABASE_URL=sqlite:///./dca.db

# PostgreSQL (sunucu icin):
# DATABASE_URL=postgresql://user:password@localhost/dca

# Admin sifresini giris yapmadan sifirlamak icin (yayinda admin giremiyorsan): bir kez tanimla, POST /api/auth/reset-admin-password-with-secret cagir, sonra satiri sil
# ADMIN_PASSWORD_RESET_SECRET=rastgele-uzun-bir-metin

# DataHub: UI stale fiyat goster (1=evet). Botlar stale fiyatla asla trade atmaz.
# DATAHUB_SERVE_STALE_FOR_UI=1

# Auth cookie: Secure=1 forces Secure flag on auth_token cookie (HTTPS). If 0, auto-detect from request.url.scheme.
# AUTH_COOKIE_SECURE=1

# --- Auth & HTTP güvenlik (varsayilan: acik) ---
# AUTH_CSRF_ENABLED=1
# AUTH_CSRF_ORIGIN_CHECK=1
# AUTH_CSRF_DOUBLE_SUBMIT=1
# AUTH_RATE_LIMIT_ENABLED=1
# AUTH_RATE_LIMIT_LOGIN_PER_IP_5MIN=20
# AUTH_RATE_LIMIT_LOGIN_PER_USER_5MIN=10
# AUTH_ALLOW_BEARER=1
# AUTH_COOKIE_PRIMARY=0
# SECURITY_HEADERS_ENABLED=1
# CSP_ENABLED=1
# CSP_REPORT_ONLY=1
# BREACH_SHUTDOWN=1
